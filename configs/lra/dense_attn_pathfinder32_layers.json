{
    "name": "lra-experiment",
    "model_config": {
        "vocab_size_or_config_json_file": 264,
        "hidden_size": 128,
        "num_hidden_layers": 6,
        "num_attention_heads": 8,
        "intermediate_size": 4,
        "hidden_act": "gelu",
        "hidden_dropout_prob": 0.05,
        "attention_probs_dropout_prob": 0.0,
        "embedding_dropout": 0.0,
        "max_position_embeddings": 1024,
        "type_vocab_size": 2,
        "initializer_range": 0.2,
        "pos_emb_type": "relpe",
        "relpe_type": "dummy",
        "pooler_function": "first",
        "pooler_no_dense": true,
        "window_size": 256,

        "layers_scheme": "danetg_danetl_danetsl",
        "layers": [
            {
                "hidden_size": 128,
                "num_hidden_layers": 6,
                "num_attention_heads": 8,
                "layer_name": "danetg",
                "layer_type": "danet",
                "pre_attn_ln_type": "max_norm",
                "local_scheme": "g",
                "post_attn_ln_type": "max_norm",
                "attention_complexity": "auto",
                "swiglu_ffn": false,
                "intermediate_size": 4

            },
            {
                "hidden_size": 128,
                "num_hidden_layers": 6,
                "num_attention_heads": 8,
                "layer_name": "danetl",
                "layer_type": "danet",
                "pre_attn_ln_type": "max_norm",
                "local_scheme": "l",
                "post_attn_ln_type": "max_norm",
                "attention_complexity": "auto",
                "intermediate_size": 4,
                "swiglu_ffn": false
            },
            {
                "hidden_size": 128,
                "num_hidden_layers": 6,
                "num_attention_heads": 4,
                "layer_name": "danetsl",
                "layer_type": "danet",
                "pre_attn_ln_type": "max_norm",
                "local_scheme": "sl",
                "post_attn_ln_type": "max_norm",
                "attention_complexity": "auto",
                "intermediate_size": 4,
                "swiglu_ffn": false
            }

        ]
    },
    "data": {
        "training": {
            "inputs": "input/train.src",
            "labels": "label/train.label"
        },
        "validation": {
            "inputs": "input/valid.src",
            "labels": "label/valid.label"
        },
        "test": {
            "inputs": "input/test.src",
            "labels": "label/test.label"
        }
    },
    "training": {
        "num_epochs": 210,
        "lr_scheduler_params": {
            "warmup_ratio": 0.1,
            "warmup_degree": 1,
            "degree": 0,
            "one_cycle_steps": 320000
        },
        "lr_schedule": "cosine",
        "lr_offset": 0.0,
        "warmup_proportion": 0.02,
        "learning_rate": 0.001,
        "weight_decay": 0.1,
        "num_workers": 4,
        "async_worker": true,
        "decay_rate": 0.90,
        "decay_step": 150,
        "one_cycle_steps": 125000
    }
}


