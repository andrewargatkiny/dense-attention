{
    "name": "lra-pathfinder32-transformer-scheme",
    "model_config": {
        "vocab_size_or_config_json_file": 264,
        "hidden_size": 128,
        "num_hidden_layers": 6,
        "num_attention_heads": 4,

        "hidden_act": "gelu",
        "hidden_dropout_prob": 0.0,
        "attention_probs_dropout_prob": 0.0,
        "embedding_dropout": 0.0,
        "max_position_embeddings": 1024,
        "type_vocab_size": 2,
        "initializer_range": 0.02,
        "pos_emb_type": "relpe",
        "relpe_type": "dummy",
        "window_size": 256,
        "intermediate_size":512,

        "layers_scheme": "tr_swa_linear",
        "layers": [
            {
                "hidden_size": 128,
                "num_attention_heads": 4,
                "layer_name": "tr",
                "layer_type": "transformer",
                "pre_attn_ln_type": "default",
                "post_attn_ln_type": "default",
                "local_scheme":"sl",
                "attention_kernel": "softmax",
                "attn_proj_biases": true
            },
            {
                "hidden_size": 128,
                "num_attention_heads": 4,
                "layer_name": "swa",
                "layer_type": "transformer",
                "pre_attn_ln_type": "default",
                "post_attn_ln_type": "default",
                "attention_kernel": "swa",
                "attn_proj_biases": true
            },
            {
                "hidden_size": 128,
                "num_attention_heads": 8,
                "layer_name": "linear",
                "layer_type": "transformer",
                "pre_attn_ln_type": "default",
                "post_attn_ln_type": "default",
                "attention_kernel": "linear",
                "local_scheme": "l",
                "feature_map": "1_plus_elu",
                "attn_proj_biases": true
            }
        ]
    },
    "data": {
        "training": {
            "inputs": "input/train.src",
            "labels": "label/train.label"
        },
        "validation": {
            "inputs": "input/valid.src",
            "labels": "label/valid.label"
        },
        "test": {
            "inputs": "input/test.src",
            "labels": "label/test.label"
        }
    },
    "training": {
        "num_epochs": 210,
        "lr_scheduler_params": {
            "warmup_ratio": 0.1,
            "warmup_degree": 1,
            "degree": 0,
            "one_cycle_steps": 320000
        },
        "lr_schedule": "cosine",
        "lr_offset": 0.0,
        "learning_rate": 0.001,
        "weight_decay": 0.0,
        "num_workers": 4
    }
}


