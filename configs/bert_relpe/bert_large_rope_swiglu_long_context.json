{
    "name": "dense_attention_bert",
    "model_config": {
        "vocab_size_or_config_json_file": 30528,
        "hidden_size": 1024,
        "num_hidden_layers": 32,
        "num_attention_heads": 1,
        "intermediate_size": 4,
        "hidden_dropout_prob": 0,
        "swiglu_ffn": true,
        "attention_complexity": "quadratic",
        "attention_probs_dropout_prob": 0,
        "pre_attn_ln_type": "scaled_max_norm",
        "post_attn_ln_type": "prescaled_max_norm",
        "embedding_ln_type": "standard_ln",
        "embedding_dropout": 0,
        "max_position_embeddings": 16384,
        "token_type_embeddings": false,
        "type_vocab_size": 2,
        "initializer_range": 0.02,
        "pos_emb_type": "relpe",
        "relpe_type": "rope",
        "relpe_scheme": "q,k",
        "final_ln_type": "standard_ln",
        "pooler_no_dense": false,
        "pooler_function": "first",
        "pooler_act": "tanh",
        "classifier_bias": true,
        "lm_head_act": "gelu",
        "lm_head_ln_type": "standard_ln",
        "local_attention": true,
        "window_size": 32
    },
    "data": {
        "training": {
            "sources": [
                {
                    "name_or_path": "HuggingFaceTB/dclm-edu",
                    "split": "train",
                    "chunk_size": 75000,
                    "dataset_weight": 0.75
                },
                {
                    "name_or_path": "codeparrot/github-code",
                    "split": "train",
                    "trust_remote_code": true,
                    "chunk_size": 25000,
                    "dataset_weight": 0.25
                }
            ],
            "shuffle": true,
            "seed": 1,
            "max_seq_length": 1024,
            "total_samples": 131072
        },
        "validation": {
            "sources": [
                {
                    "name_or_path": "HuggingFaceTB/dclm-edu",
                    "split": "train",
                    "offset": 100000,
                    "chunk_size": 12000,
                    "dataset_weight": 0.75
                },
                {
                    "name_or_path": "codeparrot/github-code",
                    "split": "train",
                    "trust_remote_code": true,
                    "offset": 100000,
                    "chunk_size": 4000,
                    "dataset_weight": 0.25
                }
            ],
            "seed": 1,
            "max_seq_length": 1024,
            "total_samples": 20000
        },
        "test": {
            "input_file": "sentence_512/validation_data/c4-validation.00000-of-00008.json.gz",
            "max_seq_length": 1024,
            "total_samples": 20000
        }
    },
    "training": {
        "num_epochs": 116,
        "lr_scheduler_params": {
            "warmup_ratio": 0.0,
            "warmup_degree": 1,
            "degree": 1,
            "one_cycle_steps": 61000
        },
        "lr_schedule": "cosine",
        "lr_offset": 0,
        "learning_rate": 5e-5,
        "weight_decay": 0.02,
        "num_workers": 4
    }
